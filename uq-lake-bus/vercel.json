{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "fluid": true,
  "functions": {
    "api/maps-link.js": {
      "maxDuration": 10
    },
    "api/departures.js": {
      "maxDuration": 30
    },
    "api/ferries.js": {
      "maxDuration": 30
    },
    "api/library-spaces.js": {
      "maxDuration": 30
    },
    "api/stops/search.js": {
      "maxDuration": 30
    }
  }
}
