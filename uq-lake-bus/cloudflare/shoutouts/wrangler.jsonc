{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "uq-helper-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-20",
  "workers_dev": true,
  "placement": {
    "mode": "smart"
  },
  "vars": {
    "ALLOWED_ORIGINS": "http://127.0.0.1:4173,http://localhost:4173,https://www.food-on-map.tech,https://food-on-map.tech",
    "FOOD_STORAGE_LIMIT_BYTES": "8589934592"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "uq-helper-shoutouts",
      "database_id": "81b2ae18-0412-4b28-87d8-51e4f91d053c",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FOOD_IMAGES",
      "bucket_name": "uq-helper-food-images"
    }
  ],
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 0.1
    },
    "traces": {
      "head_sampling_rate": 0.1
    }
  }
}
