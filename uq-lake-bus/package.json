{
  "name": "uq-lakes-bus-board",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "node server/index.js",
    "dev:shoutouts": "npx wrangler@4.124.0 dev --config cloudflare/shoutouts/wrangler.jsonc --port 8790",
    "build": "vite build",
    "start": "node server/index.js",
    "deploy:shoutouts": "npx wrangler@4.124.0 deploy --config cloudflare/shoutouts/wrangler.jsonc",
    "db:migrate:shoutouts": "npx wrangler@4.124.0 d1 migrations apply uq-helper-shoutouts --remote --config cloudflare/shoutouts/wrangler.jsonc"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "express": "^5.1.0",
    "framer-motion": "^12.38.0",
    "gtfs-realtime-bindings": "^2.2.0",
    "lucide-react": "^1.14.0",
    "maplibre-gl": "^5.24.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.6.0",
    "react-toastify": "^11.0.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "vite": "^8.0.3"
  }
}
